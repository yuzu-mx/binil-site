# Database (Cloud SQL)
DATABASE_URL=postgresql://admin:YOUR_PASSWORD@YOUR_PUBLIC_IP:5432/spots-database

# Firebase Admin (for verifying auth tokens)
FIREBASE_PROJECT_ID=your-gcp-project-id

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Google Maps / Places API
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Instagram oEmbed (Facebook Graph API)
INSTAGRAM_APP_TOKEN=your-facebook-app-token

# Server
PORT=3001
NODE_ENV=development
