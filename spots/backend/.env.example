# Database
DATABASE_URL=postgresql://user:password@localhost:5432/spots

# Firebase Admin (for verifying auth tokens)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Google Maps / Places API
GOOGLE_MAPS_API_KEY=AIza...

# Instagram oEmbed (Facebook Graph API)
INSTAGRAM_APP_TOKEN=your-facebook-app-token

# Server
PORT=3001
NODE_ENV=development
